@model Notera.Web.Models.Song

@{
    ViewData["Title"] = $"{Model.Title} - {Model.Artist}";

    string? embedUrl = null;
    if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
    {
        if (Model.YoutubeUrl.Contains("watch?v="))
        {
            var videoId = Model.YoutubeUrl.Split("watch?v=").Last().Split('&').First();
            embedUrl = $"https://www.youtube.com/embed/{videoId}";
        }
        else if (Model.YoutubeUrl.Contains("youtu.be/"))
        {
            var videoId = Model.YoutubeUrl.Split("youtu.be/").Last().Split('?').First();
            embedUrl = $"https://www.youtube.com/embed/{videoId}";
        }
    }
}

<div class="container py-4">
    <div class="mb-3">
        <a href="/Songs" class="btn btn-sm btn-outline-secondary">&larr; Şarkı Listesine Dön</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-7">
                    <span class="badge bg-primary mb-2">Şarkı Detayı</span>
                    <h1 class="h2 mb-1">@Model.Title</h1>
                    <h4 class="h5 text-muted mb-3">@Model.Artist</h4>

                    <dl class="row mb-3">
                        <dt class="col-sm-3 text-muted">Albüm</dt>
                        <dd class="col-sm-9">
                            @(string.IsNullOrWhiteSpace(Model.Album) ? "Belirtilmemiş" : Model.Album)
                        </dd>

                        <dt class="col-sm-3 text-muted">Eklenme Tarihi</dt>
                        <dd class="col-sm-9">
                            @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </dd>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(Model.YoutubeUrl))
                    {
                        <a href="@Model.YoutubeUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-danger btn-sm">
                            YouTube'da Aç
                        </a>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(embedUrl))
                {
                    <div class="col-12 col-lg-5">
                        <div class="ratio ratio-16x9 rounded overflow-hidden shadow-sm">
                            <iframe src="@embedUrl"
                                    title="@Model.Title - YouTube"
                                    allowfullscreen></iframe>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0">Enstrüman Notaları</h2>
        </div>
        <div class="card-body">
            @if (Model.Notes == null || !Model.Notes.Any())
            {
                <p class="text-muted mb-0">Bu şarkı için henüz nota kaydı eklenmemiş.</p>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @foreach (var note in Model.Notes)
                    {
                        <div class="col">
                            <div class="border rounded p-3 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>@(note.Instrument?.Name ?? "Genel Enstrüman")</strong>
                                    @if (!string.IsNullOrWhiteSpace(note.Key))
                                    {
                                        <span class="badge bg-secondary">Karar Sesi: @note.Key</span>
                                    }
                                </div>
                                <pre class="bg-light p-2 rounded mb-0 small" style="white-space: pre-wrap;">@note.Content</pre>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>