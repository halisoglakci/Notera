@model IEnumerable<Notera.Web.Models.Song>

@{
    ViewData["Title"] = "Şarkılar";
    var searchTerm = ViewBag.Search as string;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 mb-1">Şarkı Kütüphanesi</h1>
            <p class="text-muted mb-0">Kayıtlı şarkıları inceleyin ve enstrüman notalarına ulaşın.</p>
        </div>

        <form method="get" action="/Songs" class="d-flex gap-2">
            <input type="text"
                   name="search"
                   value="@searchTerm"
                   class="form-control"
                   placeholder="Şarkı, sanatçı veya albüm ara..." />
            <button type="submit" class="btn btn-primary">Ara</button>
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <a href="/Songs" class="btn btn-outline-secondary">Temizle</a>
            }
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <span>"<strong>@searchTerm</strong>" aramasına uygun şarkı bulunamadı.</span>
            }
            else
            {
                <span>Henüz veritabanında kayıtlı şarkı bulunmuyor.</span>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var song in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-1">@song.Title</h5>
                            <h6 class="card-subtitle text-muted mb-3">@song.Artist</h6>

                            @if (!string.IsNullOrWhiteSpace(song.Album))
                            {
                                <p class="card-text small text-secondary mb-3">
                                    <strong>Albüm:</strong> @song.Album
                                </p>
                            }

                            <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    @song.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </small>
                                <a href="/Songs/Details/@song.Id" class="btn btn-sm btn-outline-primary">
                                    Detayları Gör
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>